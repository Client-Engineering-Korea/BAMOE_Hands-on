      </di:extension>
      <dmndi:DMNShape id="_shape_ds_case01" dmnElementRef="_ds_case01" isCollapsed="false">
        <dc:Bounds x="20" y="0" width="870" height="340" />
        <dmndi:DMNDecisionServiceDividerLine id="_56C0F122-B115-42C1-BBFA-AE65260FF09A">
          <di:waypoint x="10" y="200" />
          <di:waypoint x="350" y="200" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_finalResult" dmnElementRef="_d_finalResult">
        <dc:Bounds x="360" y="80" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_conditionCheck" dmnElementRef="_d_conditionCheck">
        <dc:Bounds x="200" y="240" width="180" height="60" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_promoCheck" dmnElementRef="_d_promoCheck">
        <dc:Bounds x="520" y="240" width="180" height="60" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_shape_request" dmnElementRef="_in_request">
        <dc:Bounds x="340" y="440" width="200" height="60" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="_edge_pc_fr" dmnElementRef="_ir_fr_promo" sourceElement="_shape_promoCheck" targetElement="_shape_finalResult">
        <di:waypoint x="610" y="240" />
        <di:waypoint x="550" y="150" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_8CA8A029-5073-4C34-A149-646498D902A0" dmnElementRef="_D3B375AA-BC2F-40C3-ABF7-2E7A0674AA90" sourceElement="_shape_request" targetElement="_shape_promoCheck">
        <di:waypoint x="440" y="470" />
        <di:waypoint x="610" y="300" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_81368F45-9256-4AC9-B66E-D11F1853D8E5" dmnElementRef="_03464CD2-AE70-4F2A-9B89-45F92A6E52FD" sourceElement="_shape_request" targetElement="_shape_conditionCheck">
        <di:waypoint x="440" y="470" />
        <di:waypoint x="290" y="300" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_295F8ECE-112F-4B55-A217-C155BEEE7A7E" dmnElementRef="_E190BE5C-DB71-410B-8ED0-A461708B235B" sourceElement="_shape_conditionCheck" targetElement="_shape_promoCheck">
        <di:waypoint x="290" y="270" />
        <di:waypoint x="520" y="270" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_29114899-3446-4A6A-938B-49B70530011C" dmnElementRef="_1826AF17-F3BF-4BAC-84E4-EAF148DC62B8" sourceElement="_shape_conditionCheck" targetElement="_shape_finalResult">
        <di:waypoint x="290" y="270" />
        <di:waypoint x="450" y="160" />
      </dmndi:DMNEdge>
